# Frontend
VITE_API_URL=http://localhost:5000

# Auth Service
AUTH_SERVICE_PORT=5001
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret

POSTGRES_DB=billsphere_auth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing Service
BILLING_SERVICE_PORT=5002

# Usage Service
USAGE_SERVICE_PORT=5003

# MongoDB
MONGO_URI=mongodb://mongodb:27017/billsphere

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKER=kafka:9092